Spare parts edit html

{% extends "base.html" %}


{% block title %}

Edit Spare Part | FixTrack

{% endblock %}


{% block content %}

<div class="page-header">

    <h1>Edit Spare Part</h1>

    <p>
        Update spare part information.
    </p>

</div>


<div class="form-card">

    <form method="POST">

        <div class="form-grid">

            <div class="form-group">

                <label>Part Code</label>

                <input
                    type="text"
                    name="part_code"
                    value="{{ part['part_code'] }}"
                    required
                >

            </div>


            <div class="form-group">

                <label>Part Name</label>

                <input
                    type="text"
                    name="part_name"
                    value="{{ part['part_name'] }}"
                    required
                >

            </div>


            <div class="form-group">

                <label>Category</label>

                <input
                    type="text"
                    name="category"
                    value="{{ part['category'] }}"
                >

            </div>


            <div class="form-group">

                <label>Brand</label>

                <input
                    type="text"
                    name="brand"
                    value="{{ part['brand'] }}"
                >

            </div>


            <div class="form-group">

                <label>Specification</label>

                <input
                    type="text"
                    name="specification"
                    value="{{ part['specification'] }}"
                >

            </div>


            <div class="form-group">

                <label>Current Stock</label>

                <input
                    type="number"
                    name="current_stock"
                    min="0"
                    value="{{ part['current_stock'] }}"
                    required
                >

            </div>


            <div class="form-group">

                <label>Reorder Level</label>

                <input
                    type="number"
                    name="reorder_level"
                    min="0"
                    value="{{ part['reorder_level'] }}"
                    required
                >

            </div>


            <div class="form-group">

                <label>Location</label>

                <input
                    type="text"
                    name="location"
                    value="{{ part['location'] }}"
                >

            </div>

        </div>


        <div class="form-actions">

            <a
                href="{{ url_for('spare_parts.spare_parts') }}"
                class="btn btn-secondary"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="btn btn-primary"
            >
                Update Spare Part
            </button>

        </div>

    </form>

</div>

{% endblock %}


Spare parts index html 

{% extends "base.html" %}


{% block title %}

Spare Parts | FixTrack

{% endblock %}


{% block content %}

<div class="page-header page-header-row">

    <div>

        <h1>Spare Parts Inventory</h1>

        <p>
            Manage spare parts and stock levels.
        </p>

    </div>


    <a
        href="{{ url_for('spare_parts.add_spare_part') }}"
        class="btn btn-primary"
    >
        Add Spare Part
    </a>

</div>


<div class="content-card">

    <div class="table-container">

        <table>

            <thead>

                <tr>

                    <th>Part Code</th>
                    <th>Part Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Specification</th>
                    <th>Stock</th>
                    <th>Reorder Level</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Actions</th>

                </tr>

            </thead>


            <tbody>

                {% if parts %}

                    {% for part in parts %}

                    <tr>

                        <td>
                            <strong>
                                {{ part["part_code"] }}
                            </strong>
                        </td>

                        <td>
                            {{ part["part_name"] }}
                        </td>

                        <td>
                            {{ part["category"] }}
                        </td>

                        <td>
                            {{ part["brand"] }}
                        </td>

                        <td>
                            {{ part["specification"] }}
                        </td>

                        <td>
                            {{ part["current_stock"] }}
                        </td>

                        <td>
                            {{ part["reorder_level"] }}
                        </td>

                        <td>
                            {{ part["location"] }}
                        </td>

                        <td>

                            {% if part["current_stock"] <= part["reorder_level"] %}

                                <span class="status status-low">
                                    Low Stock
                                </span>

                            {% else %}

                                <span class="status status-active">
                                    In Stock
                                </span>

                            {% endif %}

                        </td>

                        <td class="action-cell">

                            <a
                                href="{{ url_for('spare_parts.edit_spare_part', part_id=part['id']) }}"
                                class="action-link"
                            >
                                Edit
                            </a>

                            <a
                                href="{{ url_for('spare_parts.delete_spare_part', part_id=part['id']) }}"
                                class="action-link danger"
                                onclick="return confirm('Delete this spare part?')"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                    {% endfor %}

                {% else %}

                    <tr>

                        <td
                            colspan="10"
                            class="empty-table"
                        >
                            No spare parts added yet.
                        </td>

                    </tr>

                {% endif %}

            </tbody>

        </table>

    </div>

</div>

{% endblock %}


Spare parts add html 

{% extends "base.html" %}


{% block title %}

Add Spare Part | FixTrack

{% endblock %}


{% block content %}

<div class="page-header">

    <h1>Add Spare Part</h1>

    <p>
        Add a new item to the spare parts inventory.
    </p>

</div>


<div class="form-card">

    <form method="POST">

        <div class="form-grid">

            <div class="form-group">

                <label>Part Code</label>

                <input
                    type="text"
                    name="part_code"
                    placeholder="Example: SP-001"
                    required
                >

            </div>


            <div class="form-group">

                <label>Part Name</label>

                <input
                    type="text"
                    name="part_name"
                    placeholder="Example: Bearing"
                    required
                >

            </div>


            <div class="form-group">

                <label>Category</label>

                <input
                    type="text"
                    name="category"
                    placeholder="Example: Mechanical"
                >

            </div>


            <div class="form-group">

                <label>Brand</label>

                <input
                    type="text"
                    name="brand"
                    placeholder="Example: SKF"
                >

            </div>


            <div class="form-group">

                <label>Specification</label>

                <input
                    type="text"
                    name="specification"
                    placeholder="Example: 6205 ZZ"
                >

            </div>


            <div class="form-group">

                <label>Current Stock</label>

                <input
                    type="number"
                    name="current_stock"
                    min="0"
                    value="0"
                    required
                >

            </div>


            <div class="form-group">

                <label>Reorder Level</label>

                <input
                    type="number"
                    name="reorder_level"
                    min="0"
                    value="5"
                    required
                >

            </div>


            <div class="form-group">

                <label>Location</label>

                <input
                    type="text"
                    name="location"
                    placeholder="Example: Rack A-2"
                >

            </div>

        </div>


        <div class="form-actions">

            <a
                href="{{ url_for('spare_parts.spare_parts') }}"
                class="btn btn-secondary"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="btn btn-primary"
            >
                Save Spare Part
            </button>

        </div>

    </form>

</div>

{% endblock %}
